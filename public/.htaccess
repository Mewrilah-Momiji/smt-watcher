# The content security policy is set in the page. frame-ancestors only works as a header.
Options -Indexes
# The host's placeholder index.htm must not win over the page.
DirectoryIndex index.html
ErrorDocument 404 /404.html
# Visitors always get the encrypted page.
RewriteEngine On
# One address only, so that search engines do not list the page twice.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# The former page with both texts.
RedirectMatch 301 /legal\.html$ /imprint.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
