# Copy to .deploy.env and fill in. Git ignores that file. Never commit real values.
# Best use an extra FTP user that is limited to the subdomain's folder.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Folder as seen by this FTP user. Use / if the user is limited to the subdomain's folder.
FTP_DIR=/
# Optional: keep private/ (database, keys, settings) outside the web root. Needs an FTP user that sees the folder above
# the web root. Both are absolute FTP paths, for example FTP_DIR=/smtw/ and PRIVATE_DIR=/smtw-private/.
PRIVATE_DIR=
# For a second server, e.g. a former one: copy to .deploy.old.env, put the differing page values into .env.old.local,
# and run SMTW_PROFILE=old npm run deploy:senderdb. Git ignores both files.
