# Operator details for the imprint and the contact form. Copy this file to .env.local, which Git ignores, and enter your own.
# The build stops if one of them is missing, so that no page goes online with an empty imprint.
VITE_OPERATOR_NAME=Erika Mustermann
VITE_OPERATOR_STREET=Musterstraße 1
VITE_OPERATOR_CITY=12345 Musterstadt
VITE_OPERATOR_EMAIL=contact@example.org

# Address of your own copy of the page, with a slash at the end. The Thunderbird extension links to it and sends
# reports and lookups there. Also used by scripts/seed. Keep the add-on ID unique to your copy.
VITE_SITE_URL=https://smtw.example.org/
VITE_ADDON_ID=smt-watcher@example.org
