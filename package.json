{
  "name": "smt-watcher",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.5.44",
  "thunderbirdVersion": "0.5.44",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:thunderbird": "tsc --noEmit && vite build --mode thunderbird",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "deploy": "tsc --noEmit && node scripts/thunderbird-release.mjs && vite build && node scripts/deploy.mjs",
    "check:thunderbird": "npm run build:thunderbird && node scripts/thunderbird-check.mjs",
    "package:thunderbird": "npm run build:thunderbird && node scripts/thunderbird-package.mjs",
    "test:browser:db": "tsc --noEmit && vite build --mode senderdb && playwright test -g sender",
    "deploy:senderdb": "tsc --noEmit && node scripts/thunderbird-release.mjs && vite build --mode senderdb && node scripts/deploy.mjs --sender-db"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.29.0",
    "iconv-lite": "^0.7.3",
    "libphonenumber-js": "1.13.15",
    "postal-mime": "^4.2.0",
    "rtf-stream-parser": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "basic-ftp": "^6.2.5",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
